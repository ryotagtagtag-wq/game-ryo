---
layout: page.njk
permalink: /uses/
title: Uses
eleventyComputed:
  usesData: "uses"
---
{% block head_css %}
<link rel="stylesheet" href="/css/pages/uses.css" />
{% endblock %}
{% block content %}
<div class="bg-glow"></div>
<div class="bg-glow-2"></div>

<section class="section" style="padding:64px 0 40px;border-top:none">
  <p class="label mono">// uses</p>
  <h1 class="page-title" style="margin:0 0 12px;font-size:clamp(40px,6vw,56px);line-height:1.1;font-weight:900" data-i18n="uses_title">Uses</h1>
  <p class="page-subtitle" style="margin:0;color:var(--text-muted)" data-i18n="uses_subtitle">日常的に使っているツール・環境・ガジェット (<a href="https://uses.tech/" target="_blank" rel="noopener" style="color:var(--accent)">uses.tech</a> 形式)</p>
</section>

{% for category in ["hardware", "software", "cloud", "gaming"] %}
{% set items = usesData[category] %}
{% if items and items.length > 0 %}
<section class="section">
  <h2 class="section-title" style="margin:0 0 20px;font-size:24px" data-i18n="uses_{{ category }}">
    {% if category == "hardware" %}💻 Hardware
    {% elseif category == "software" %}🛠 Software / Development
    {% elseif category == "cloud" %}☁️ Cloud & Services
    {% elseif category == "gaming" %}🎮 Gaming & Others
    {% endif %}
  </h2>
  <div class="grid-auto">
    {% for item in items %}
    <div class="card">
      <strong>{{ item.name }}</strong>
      <p style="margin:8px 0 0;font-size:14px;color:var(--text-muted)">{{ item.desc }}</p>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endfor %}

<section class="section" style="border-top:1px solid var(--border);padding-top:32px">
  <p style="margin:0;color:var(--text-muted);font-size:14px;text-align:center">
    <a href="https://github.com/ryotagtagtag-wq" target="_blank" rel="noopener" style="color:var(--accent)">GitHub</a> /
    <a href="https://dotfiles.ryopc.org" target="_blank" rel="noopener" style="color:var(--accent)">Dotfiles</a> /
    更新: {{ buildDate }}
  </p>
</section>
{% endblock %}