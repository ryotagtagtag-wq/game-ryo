---
layout: page.njk
permalink: /blog/index.html
pagination:
  data: blogs
  size: 10
  alias: posts
  reverse: true
---

{% block head_css %}
<link rel="stylesheet" href="/css/pages/blog.css" />
{% endblock %}

{% block content %}
<div class="bg-glow"></div>
<div class="bg-glow-2"></div>

<section class="section" style="padding:64px 0 40px;border-top:none">
  <p class="label mono">// blog</p>
  <h1 class="page-title" style="margin:0 0 12px;font-size:clamp(40px,6vw,56px);line-height:1.1;font-weight:900" data-i18n="blog_header">Blog</h1>
  <p style="margin:0;color:var(--text-muted)" data-i18n="blog_subtitle">技術のログや、日々考えていることの発信</p>
</section>

<section class="section blog-list-section" style="padding:8px 0 48px">
  <div style="display:grid;gap:16px">
    {% if posts and posts.length > 0 %}
      {% for post in posts %}
        {% from "macros/content.njk" import blogCard %}
        {{ blogCard(post) }}
      {% endfor %}
    {% else %}
      <div class="empty-fallback card">
        <p data-i18n="empty_blog_msg"></p>
      </div>
    {% endif %}
  </div>

  {% if pagination.href.previous or pagination.href.next %}
  <nav class="pagination" style="display:flex;justify-content:center;gap:var(--space-3);margin-top:var(--space-7);flex-wrap:wrap">
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" class="btn btn-secondary" data-i18n="pagination_prev">← 前へ</a>
    {% endif %}
    <span class="pagination-info mono" style="display:flex;align-items:center;color:var(--text-muted)">
      {{ pagination.pageNumber + 1 }} / {{ pagination.pages.length }}
    </span>
    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="btn btn-secondary" data-i18n="pagination_next">次へ →</a>
    {% endif %}
  </nav>
  {% endif %}
</section>
{% endblock %}