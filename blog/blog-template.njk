---
layout: article.njk
permalink: "blog/articles/{{ post.id }}/index.html"
pagination:
  data: blogs
  size: 1
  alias: post
tags: blog
---

{% block head_css %}
<link rel="stylesheet" href="/css/pages/article.css" />
{% endblock %}

{% block content %}
<div class="bg-glow"></div>
<div class="bg-glow-2"></div>

<div id="scroll-progress"></div>

<header class="article-header">
  <div class="article-meta">
    <span class="mono">{{ post.publishedAt }}</span>
  </div>
  <h1>{{ post.title }}</h1>
</header>

{% if post.eyecatch and post.eyecatch.metadata %}
<figure class="article-eyecatch">
  {{ generateHTML(post.eyecatch.metadata, {
    alt: post.title,
    loading: "eager",
    decoding: "async",
    sizes: "(max-width: 720px) 100vw, (max-width: 1200px) 90vw, 720px",
    class: "eyecatch-img",
    width: 1200,
    height: 675
  }) | safe }}
</figure>
{% elif post.eyecatch and post.eyecatch.url %}
<figure class="article-eyecatch">
  <img src="{{ post.eyecatch.url }}" alt="{{ post.title }}" loading="eager" decoding="async" class="eyecatch-img" width="1200" height="675">
</figure>
{% endif %}

<div class="container article-container">
  <aside class="toc-sidebar" id="toc-sidebar">
    <nav class="toc" id="toc">
      <h3 class="toc-title mono" data-i18n="toc_title">目次</h3>
      <ul class="toc-list" id="toc-list"></ul>
    </nav>
  </aside>

  <main class="article-main">
    <article class="article-card">
      <div class="article-body">
        {{ post.content | sanitizeHtml | safe }}
      </div>
    </article>

    <!-- Comments -->
    {% include "comments.njk" %}

    <!-- Sponsor Widget -->
    <section class="sponsor-section" aria-label="スポンサー" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--r-card); padding: var(--space-5); text-align: center;">
      <div class="sponsor-label" data-i18n="sponsor_label">Sponsored</div>
      <div class="sponsor-widget" style="min-height: 90px;">
        <script async src="https://ar-cdn.net/widget/v1.js" 
                data-site-id="505f611f-55b4-4968-914f-faf32ef5e8c7" 
                data-variant="leaderboard">
        </script>
      </div>
    </section>
  </main>
</div>

<nav class="article-nav">
  <a href="/" class="btn btn-secondary" data-i18n="btn_back_home">← ホームに戻る</a>
</nav>
{% endblock %}

{% block scripts %}
<script>
// TOC Generation
(function() {
  const article = document.querySelector('.article-body');
  const tocList = document.getElementById('toc-list');
  if (!article || !tocList) return;

  const headings = article.querySelectorAll('h1, h2, h3, h4');
  if (headings.length === 0) {
    document.getElementById('toc-sidebar').style.display = 'none';
    return;
  }

  headings.forEach((heading, index) => {
    const id = heading.id || `heading-${index}`;
    heading.id = id;
    const li = document.createElement('li');
    li.className = 'toc-item toc-' + heading.tagName.toLowerCase();
    li.innerHTML = `<a href="#${id}">${heading.textContent}</a>`;
    tocList.appendChild(li);
  });
})();

// Scroll Progress Bar
(function() {
  const progressBar = document.getElementById('scroll-progress');
  if (!progressBar) return;

  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrollPercent = (scrollTop / docHeight) * 100;
    progressBar.style.width = scrollPercent + '%';
  });
})();
</script>
{% endblock %}