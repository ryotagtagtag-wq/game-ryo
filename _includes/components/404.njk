<div class="bg-glow"></div>
<div class="bg-glow-2"></div>

<main style="max-width: 900px; margin: 0 auto; padding: 8rem 1.5rem 4rem; flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;">
  <div class="error-container">
    <svg class="error-illustration" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="100" cy="100" r="85" stroke="url(#paint0_linear)" stroke-width="2.5" stroke-dasharray="8 12" />
      <circle cx="100" cy="100" r="65" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="50 15 90 25" opacity="0.6"/>
      <circle cx="60" cy="80" r="5" fill="var(--accent)" />
      <circle cx="140" cy="80" r="5" fill="var(--accent)" />
      <circle cx="100" cy="145" r="5" fill="var(--accent-2)" />
      <path d="M60 80 L100 100" stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 4" opacity="0.5"/>
      <path d="M140 80 L100 100" stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 4" opacity="0.5"/>
      <path d="M100 145 L100 100" stroke="var(--accent-2)" stroke-width="2" stroke-dasharray="4 4" opacity="0.5"/>
      <path d="M100 65 L130 82 L130 118 L100 135 L70 118 L70 82 Z" stroke="url(#paint0_linear)" stroke-width="3" fill="rgba(6, 182, 212, 0.08)" />
      <path d="M100 65 L100 135" stroke="url(#paint0_linear)" stroke-width="1.5" opacity="0.7" />
      <path d="M70 82 L100 100 L130 82" stroke="url(#paint0_linear") stroke-width="1.5" opacity="0.7" />
      <path d="M100 85 V105" stroke="#ffffff" stroke-width="4.5" stroke-linecap="round" />
      <circle cx="100" cy="116" r="3" fill="#ffffff" />
      <defs>
        <linearGradient id="paint0_linear" x1="20" y1="20" x2="180" y2="180" gradientUnits="userSpaceOnUse">
          <stop stop-color="var(--accent)"/>
          <stop offset="1" stop-color="var(--accent-2)"/>
        </linearGradient>
      </defs>
    </svg>

    <div class="error-code">404</div>
    <h1 class="error-title" data-i18n="error_title">ページが見つかりません</h1>
    <p class="error-desc" data-i18n="error_desc">お探しのページは、移動または削除されたか、最初から存在しない可能性があります。</p>

    <div class="card error-card">
      <div class="btn-container">
        <a href="/" class="btn-primary" data-i18n="btn_home">トップページへ戻る</a>
        <a href="/blog/" class="btn-secondary" data-i18n="btn_blog">ブログを読む</a>
      </div>
    </div>

    <div class="status-badge-container">
      <div class="status-badge">
        <span class="status-dot"></span>
        <span data-i18n="status_text">ステータス: 個人サイトとして運営中</span>
      </div>
    </div>
  </div>
</main>