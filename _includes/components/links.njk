<section class="section" style="padding:48px 0;border-top:1px solid var(--border)">
  <p class="label mono">// links</p>
  <h2 class="section-title" style="margin:0 0 20px;font-size:24px" data-i18n="links_title">相互リンク</h2>
  <ul style="list-style:none;margin:0;padding:0;display:grid;gap:12px">
    {% for link in links %}
    <li class="card" style="padding:18px 20px">
      <a href="{{ link.url }}" target="_blank" rel="noopener" style="font-weight:700">{{ link.name }}</a>
      <span style="display:block;font-size:14px;color:var(--text-muted)">{{ link.desc }}</span>
    </li>
    {% endfor %}
  </ul>
</section>