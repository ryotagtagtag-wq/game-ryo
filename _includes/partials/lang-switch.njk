<span class="lang-pill mono" role="group" aria-label="Language switcher">
  <button type="button" class="lang-btn {% if lang == 'ja' %}active{% endif %}" data-lang="ja" aria-label="日本語">JP</button>
  <button type="button" class="lang-btn {% if lang == 'en' %}active{% endif %}" data-lang="en" aria-label="English">EN</button>
</span>